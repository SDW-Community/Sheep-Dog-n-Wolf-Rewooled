<mxfile host="drawio" agent="sdw-diagrams" version="24.0.0"><diagram id="p0" name="1. One frame (Main_Loop)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="One frame of the game - Main_Loop, top to bottom, every iteration" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Read each column top to bottom. Dashed arrows = &quot;expands into&quot;; solid = calls / data flow. Everything in columns B-D happens &lt;i&gt;inside&lt;/i&gt; step A6 / A10." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1600" height="24" as="geometry"/></mxCell><mxCell id="c3" value="A. Main_Loop  (src/app/app_main.cpp)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="400" height="1090" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;A1  Events&lt;/b&gt;&lt;br&gt;SoundDevice::PollStreamEvents, then Platform_PollEvents: SDL quit, controller plugged/unplugged, mouse wheel/motion/right-click counters, F3 perf overlay, F5 cam debug, F11 fullscreen&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;platform/platform_sdl.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="40" width="360" height="100" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;A2  Focus&lt;/b&gt;&lt;br&gt;window inactive -&gt; active: drop the menu noise texture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="155" width="360" height="50" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;A3  Time_Update&lt;/b&gt;&lt;br&gt;g_dt = frame time in 1/4096 s, &lt;b&gt;capped at 0xAA (41.5 ms)&lt;/b&gt; -&gt; under ~24 fps the game runs in slow motion; 0 while paused. Also g_dtRaw, g_animDt, g_dtMs&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/time.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="220" width="360" height="95" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;A4  Platform_SetMouseCaptured&lt;/b&gt;&lt;br&gt;captured unless paused or Legacy Controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="330" width="360" height="50" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;A5  PolyBatcher::Render_BeginFrame&lt;/b&gt;&lt;br&gt;&lt;i&gt;only if the renderer is ready&lt;/i&gt;: outline textures, clear colour + Z, BeginScene, default state flags&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/polybatcher.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="395" width="360" height="85" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;A6  Game_Frame_2()&lt;/b&gt;&lt;br&gt;&lt;i&gt;only if a level is loaded&lt;/i&gt; (GF_LEVEL_LOADED_A &amp;amp; B) -&gt; column B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;strokeWidth=2;" vertex="1" parent="c3"><mxGeometry x="20" y="495" width="360" height="60" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;A7  Input_Poll&lt;/b&gt;&lt;br&gt;InputMgr::Poll -&gt; Pad_ReadRaw -&gt; g_pad.Latch. &lt;b&gt;Runs after the game update&lt;/b&gt;: objects read last frame's pad -&gt; column E&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/input.cpp, engine/input_mgr.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="570" width="360" height="95" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;A8  Cheat_Poll&lt;/b&gt;&lt;br&gt;level-skip cheat -&gt; Fade_StartLevelExit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="680" width="360" height="50" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;A9  Level_ExitUpdate  (if g_levelExitFlags)&lt;/b&gt;&lt;br&gt;finish / restart / demo -&gt; Progress -&gt; GotoScene -&gt; &lt;b&gt;frees and loads the next level right here, mid-frame&lt;/b&gt; (page 2); or Transition_Update (hole FX, its own loop)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/scenaric.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="745" width="360" height="110" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;A10  Render_EndFrame(1)&lt;/b&gt;&lt;br&gt;Flush every queued polygon -&gt; column D, then EndScene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;strokeWidth=2;" vertex="1" parent="c3"><mxGeometry x="20" y="870" width="360" height="65" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;A11  Render_Present(g_maxFps)&lt;/b&gt;&lt;br&gt;runs even with no device: g_renderDevice-&gt;Present, restore lost surfaces, Frame_LimitFps (60)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="950" width="360" height="80" as="geometry"/></mxCell><mxCell id="t15" value="loop until quit" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="200" height="20" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="next frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="1080"/><mxPoint x="30" y="180"/></Array></mxGeometry></mxCell><mxCell id="c27" value="B. Game_Frame_2  (engine/scenaric_loop.cpp)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="420" height="645" as="geometry"/></mxCell><mxCell id="b28" value="&lt;b&gt;B1  Menu openers&lt;/b&gt;&lt;br&gt;Select -&gt; select menu / map; Esc -&gt; PauseMenu_Open; P -&gt; PausedMenu_Open. Each checks: no cinematic, no voice line (StreamPlayer busy), GameState allows, not paused; toggles GF_PAUSE_TOGGLE&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;reads g_pad, g_inputMgr.escPressed / pausePressed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9ec;strokeColor=#c2558c;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c27"><mxGeometry x="20" y="40" width="380" height="115" as="geometry"/></mxCell><mxCell id="b29" value="&lt;b&gt;Map open?&lt;/b&gt;&lt;br&gt;SelectMenu state 2..5" style="rhombus;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9ec;strokeColor=#c2558c;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;align=center;spacingLeft=0;" vertex="1" parent="c27"><mxGeometry x="130" y="170" width="160" height="60" as="geometry"/></mxCell><mxCell id="b30" value="&lt;b&gt;Map_Update&lt;/b&gt;&lt;br&gt;the map screen replaces the whole game frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9ec;strokeColor=#c2558c;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c27"><mxGeometry x="20" y="250" width="170" height="75" as="geometry"/></mxCell><mxCell id="b31" value="&lt;b&gt;Gameplay&lt;/b&gt;&lt;br&gt;SelectMenu_UpdateWipe&lt;br&gt;&lt;b&gt;Game_Frame()&lt;/b&gt; -&gt; column C&lt;br&gt;PauseMenu_Update if paused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;strokeWidth=2;" vertex="1" parent="c27"><mxGeometry x="210" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="b32" value="&lt;b&gt;B4  Letterbox_Update&lt;/b&gt;&lt;br&gt;cinema bars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c27"><mxGeometry x="20" y="360" width="380" height="50" as="geometry"/></mxCell><mxCell id="b33" value="&lt;b&gt;B5  StreamPlayer::Update&lt;/b&gt;&lt;br&gt;music / voice-line state machine; a loader thread opens the next clip (double-buffered StreamSounds)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/stream_player.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c27"><mxGeometry x="20" y="425" width="380" height="85" as="geometry"/></mxCell><mxCell id="b34" value="&lt;b&gt;B6  Sound_MixerTick&lt;/b&gt;&lt;br&gt;starts voices requested by Sound_Play this frame: rebuild buffer, gain = distance to camera x volume x SFX volume, frequency -&gt; DirectSound -&gt; SDL mixer -&gt; column E&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/sound_mgr.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c27"><mxGeometry x="20" y="525" width="380" height="100" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b28" target="b29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b29" target="b30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b29" target="b31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b30" target="b32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b31" target="b32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b32" target="b33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b33" target="b34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="expands" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b9" target="b28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="615"/><mxPoint x="460" y="187"/></Array></mxGeometry></mxCell><mxCell id="c43" value="C. Game_Frame  (engine/scenaric_loop.cpp)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="940" y="90" width="460" height="1150" as="geometry"/></mxCell><mxCell id="c44" value="UPDATE  - if g_gameFlags &amp; GF_UPDATE_OBJECTS" style="swimlane;startSize=26;html=1;whiteSpace=wrap;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="c43"><mxGeometry x="15" y="35" width="430" height="470" as="geometry"/></mxCell><mxCell id="b45" value="&lt;b&gt;Weather_UpdateRain / Snow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c44"><mxGeometry x="15" y="35" width="400" height="35" as="geometry"/></mxCell><mxCell id="b46" value="&lt;b&gt;Fade_Update&lt;/b&gt;&lt;br&gt;a finished fade-out -&gt; Scenaric_ResetAll (Reset() on every object)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c44"><mxGeometry x="15" y="80" width="400" height="55" as="geometry"/></mxCell><mxCell id="b47" value="&lt;b&gt;Scenaric_UpdateAll&lt;/b&gt;&lt;br&gt;for every object in g_scnActive: store camDist2 (distance to the &lt;i&gt;previous&lt;/i&gt; camera); call the virtual &lt;b&gt;obj-&amp;gt;Update()&lt;/b&gt; if within 3000 units or ALWAYS_UPDATE (cinematic rules differ). Inside: Wolf::Update reads g_pad, steers, collides, plays sounds, sends messages; every other object does the same its own way&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;~180 object classes, 1208 HandleMessage call sites&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;strokeWidth=2;" vertex="1" parent="c44"><mxGeometry x="15" y="145" width="400" height="160" as="geometry"/></mxCell><mxCell id="b48" value="&lt;b&gt;Camera_Update&lt;/b&gt;&lt;br&gt;after the objects. Modes: follow / orbit, look, Sam chase, directed, rocket, scripted. Reads g_pWolf, g_pad (right stick, L2/R2), CameraRestriction zones; collides with walls&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;objects/camera.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c44"><mxGeometry x="15" y="315" width="400" height="120" as="geometry"/></mxCell><mxCell id="c49" value="RENDER  - if g_gameFlags &amp; GF_RENDER_WORLD" style="swimlane;startSize=26;html=1;whiteSpace=wrap;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="c43"><mxGeometry x="15" y="520" width="430" height="385" as="geometry"/></mxCell><mxCell id="b50" value="&lt;b&gt;Camera_UpdateUnderwater&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c49"><mxGeometry x="15" y="35" width="400" height="35" as="geometry"/></mxCell><mxCell id="b51" value="&lt;b&gt;Static world&lt;/b&gt;&lt;br&gt;sky meshes, clear Z, then every WorldObj through its draw function" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c49"><mxGeometry x="15" y="80" width="400" height="60" as="geometry"/></mxCell><mxCell id="b52" value="&lt;b&gt;Scenaric_RenderAll&lt;/b&gt;&lt;br&gt;attached objects' parents first; every visible object (distance + plane test, not hidden) -&gt; virtual &lt;b&gt;obj-&amp;gt;Render(&amp;amp;g_camera)&lt;/b&gt;; cinematic tagged objects; the item wheel&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;-&gt; column D&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;strokeWidth=2;" vertex="1" parent="c49"><mxGeometry x="15" y="150" width="400" height="115" as="geometry"/></mxCell><mxCell id="b53" value="&lt;b&gt;Weather_RenderRain / Snow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c49"><mxGeometry x="15" y="275" width="400" height="35" as="geometry"/></mxCell><mxCell id="t54" value="Nothing is drawn yet: every step only &lt;b&gt;queues&lt;/b&gt; polygons in the PolyBatcher. They are drawn at A10." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="c49"><mxGeometry x="20" y="320" width="390" height="50" as="geometry"/></mxCell><mxCell id="b55" value="&lt;b&gt;Inventory_UpdateFx&lt;/b&gt;&lt;br&gt;only when update AND render are on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c43"><mxGeometry x="15" y="920" width="430" height="50" as="geometry"/></mxCell><mxCell id="b56" value="&lt;b&gt;Cinematic handshake&lt;/b&gt;&lt;br&gt;if g_cinePlayer active: Update() once the Wolf answered MSG_WOLF_IS_CINE_READY, else ask it again; frustum culling off during cinematics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c43"><mxGeometry x="15" y="980" width="430" height="85" as="geometry"/></mxCell><mxCell id="b57" value="&lt;b&gt;TexScroll_UpdateAll&lt;/b&gt;&lt;br&gt;animated / scrolling textures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c43"><mxGeometry x="15" y="1075" width="430" height="50" as="geometry"/></mxCell><mxCell id="e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b45" target="b46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b46" target="b47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b47" target="b48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b50" target="b51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b51" target="b52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b52" target="b53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b55" target="b56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b56" target="b57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="b55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e68" value="Game_Frame()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.03;entryDx=0;entryDy=0;" edge="1" parent="1" source="b31" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="D. How a polygon reaches the screen" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1440" y="90" width="460" height="990" as="geometry"/></mxCell><mxCell id="b70" value="&lt;b&gt;obj-&amp;gt;Render(camera)&lt;/b&gt;&lt;br&gt;ScnBody / ScnMobile / Wolf ... (virtual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="40" width="420" height="55" as="geometry"/></mxCell><mxCell id="b71" value="&lt;b&gt;Instance_DrawAnimated&lt;/b&gt;&lt;br&gt;finds the Mesh of the object's model (Texture_FindByResource)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;objects/world_draw.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="110" width="420" height="70" as="geometry"/></mxCell><mxCell id="b72" value="&lt;b&gt;AnimMesh::DrawAll&lt;/b&gt;&lt;br&gt;per part: BuildMatrices (rotation, offset, parent); RenderDevice::ProcessVertices transforms the vertices &lt;b&gt;on the CPU&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/anim_mesh.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="195" width="420" height="85" as="geometry"/></mxCell><mxCell id="b73" value="&lt;b&gt;Mesh_DrawOutlined / DrawImmediate&lt;/b&gt;&lt;br&gt;back-face + screen cull, fog per vertex, outlines -&gt; RenderPoly (already in screen space)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/mesh.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="295" width="420" height="80" as="geometry"/></mxCell><mxCell id="b74" value="&lt;b&gt;PolyBatcher::SubmitPoly&lt;/b&gt;&lt;br&gt;untextured -&gt; flat batch&lt;br&gt;opaque texture page -&gt; that page's batch (drawn early, full batches flush at once)&lt;br&gt;blended / additive / other pages -&gt; sorted pool&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/polybatcher.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;strokeWidth=2;" vertex="1" parent="c69"><mxGeometry x="20" y="390" width="420" height="105" as="geometry"/></mxCell><mxCell id="b75" value="&lt;b&gt;Everything else submits too&lt;/b&gt;&lt;br&gt;Text_DrawString (prompts, button icons), Draw2D / HUD (UiQuad, Sprite), menus, map, emitters / particles, shadows, weather, debug draw, hole FX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9ec;strokeColor=#c2558c;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="510" width="420" height="85" as="geometry"/></mxCell><mxCell id="b76" value="&lt;b&gt;Flush  (at A10)&lt;/b&gt;&lt;br&gt;1. flat batch  2. each opaque page's batch  3. lines  4. Z-write off, &lt;b&gt;qsort the sorted pool back to front&lt;/b&gt;, draw alpha / additive / textured (HUD + text land here)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;strokeWidth=2;" vertex="1" parent="c69"><mxGeometry x="20" y="630" width="420" height="100" as="geometry"/></mxCell><mxCell id="b77" value="&lt;b&gt;D3DApp state flags + SDW_RD hooks&lt;/b&gt;&lt;br&gt;the original Direct3D 7 calls kept, routed to g_renderDevice&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;app/d3dapp.cpp, include/sdw_render.h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="745" width="420" height="75" as="geometry"/></mxCell><mxCell id="b78" value="&lt;b&gt;RenderDevice -&amp;gt; SDL3 GPU backend&lt;/b&gt;&lt;br&gt;Vulkan / Direct3D 12 / Metal; game.hlsl / game.metal (modulate, fog, alpha test)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;render/sdl3/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="835" width="420" height="75" as="geometry"/></mxCell><mxCell id="b79" value="&lt;b&gt;Present + Frame_LimitFps  (at A11)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c69"><mxGeometry x="20" y="925" width="420" height="40" as="geometry"/></mxCell><mxCell id="e80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b70" target="b71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b71" target="b72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b72" target="b73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b73" target="b74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b76" target="b77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b77" target="b78"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b78" target="b79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b75" target="b74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b74" target="b76"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1918" y="532"/><mxPoint x="1918" y="770"/></Array></mxGeometry></mxCell><mxCell id="e89" value="obj-&gt;Render()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b52" target="b70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e90" value="world meshes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b51" target="b73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e91" value="Flush()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b76"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="992"/><mxPoint x="925" y="1270"/><mxPoint x="1420" y="1270"/><mxPoint x="1420" y="770"/></Array></mxGeometry></mxCell><mxCell id="b92" value="&lt;b&gt;E1  Input chain (A7)&lt;/b&gt;&lt;br&gt;1. Platform_Read{Keyboard, Joystick, Mouse} (SDL)&lt;br&gt;2. Keyboard / Joystick / Mouse::Update (InputDevice)&lt;br&gt;3. InputMgr::Poll: which device is in use, bindings (keyTable / padTable) -&gt; PS1 button word &lt;b&gt;padBits&lt;/b&gt;, sticks, tap-to-run&lt;br&gt;4. Pad_ReadRaw -&gt; &lt;b&gt;g_pad&lt;/b&gt;.Latch (cur / prev, auto-repeat)&lt;br&gt;5. read during the &lt;i&gt;next&lt;/i&gt; frame by Wolf (ScnControllable::ReadPad), Camera, menus, objects (g_pad in 26 files)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;docs/input-system.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1940" y="90" width="460" height="210" as="geometry"/></mxCell><mxCell id="b93" value="&lt;b&gt;E2  Audio chain (B5, B6)&lt;/b&gt;&lt;br&gt;Sound_Play (73 files) only &lt;i&gt;requests&lt;/i&gt; a voice -&gt; Sound_MixerTick builds and starts it -&gt; SoundDevice (g_pSoundSystem) -&gt; DirectSound interfaces (dsound_sdl.cpp) -&gt; SDL3 mixer (platform_audio_sdl.cpp).&lt;br&gt;StreamPlayer: music per level + voice lines from Voices/, a loader thread, ducking the music for a voice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1940" y="315" width="460" height="165" as="geometry"/></mxCell><mxCell id="b94" value="&lt;b&gt;E3  Loops outside Main_Loop&lt;/b&gt;&lt;br&gt;&lt;b&gt;Transition_Update&lt;/b&gt; (hole FX): its own clear / draw / present loop with Platform_PumpEvents, ~3 s a phase.&lt;br&gt;&lt;b&gt;Level load&lt;/b&gt;: GotoScene runs inside A9, blocking.&lt;br&gt;&lt;b&gt;Video_PlaySequence&lt;/b&gt;: stubbed, the FMVs are skipped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1940" y="495" width="460" height="135" as="geometry"/></mxCell><mxCell id="b95" value="&lt;b&gt;E4  Things that make it hard to change (observed)&lt;/b&gt;&lt;br&gt;1. Input is read &lt;b&gt;after&lt;/b&gt; the update -&gt; one frame of input lag; the order is fixed by Main_Loop.&lt;br&gt;2. Update and render are interleaved in one function and gated by one global bit field (g_gameFlags, 33 files).&lt;br&gt;3. Objects cull and fade with the &lt;i&gt;previous&lt;/i&gt; frame's camera (Camera_Update runs after them).&lt;br&gt;4. The next level is loaded in the middle of a frame (A9), between queueing and flushing.&lt;br&gt;5. Transition and loading run their own loops with their own Present.&lt;br&gt;6. Time step capped at 41.5 ms: slow motion instead of frame skipping.&lt;br&gt;7. Every system is a global singleton reached directly: g_pWolf (111 files), g_dt (65), g_camera (55), g_cinePlayer (29), g_pProgress (28), g_screen (28), g_pPolyBin (26), g_pad (26).&lt;br&gt;8. Objects talk through HandleMessage with numeric ids (1208 call sites) - no typed interface.&lt;br&gt;9. Vertex transform runs on the CPU per mesh part; the GPU only gets screen-space triangles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1940" y="645" width="460" height="375" as="geometry"/></mxCell><mxCell id="e96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="b92"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="688"/><mxPoint x="450" y="70"/><mxPoint x="1920" y="70"/><mxPoint x="1920" y="195"/></Array></mxGeometry></mxCell><mxCell id="e97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b34" target="b93"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="665"/><mxPoint x="915" y="1290"/><mxPoint x="1930" y="1290"/><mxPoint x="1930" y="397"/></Array></mxGeometry></mxCell><mxCell id="c98" value="Legend: colour = system" style="swimlane;startSize=28;html=1;whiteSpace=wrap;collapsible=0;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1940" y="1040" width="260" height="320" as="geometry"/></mxCell><mxCell id="b99" value="Platform (SDL3, OS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="36" width="236" height="22" as="geometry"/></mxCell><mxCell id="b100" value="Time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="62" width="236" height="22" as="geometry"/></mxCell><mxCell id="b101" value="Input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="88" width="236" height="22" as="geometry"/></mxCell><mxCell id="b102" value="Game logic / objects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="114" width="236" height="22" as="geometry"/></mxCell><mxCell id="b103" value="Camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="140" width="236" height="22" as="geometry"/></mxCell><mxCell id="b104" value="Rendering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="166" width="236" height="22" as="geometry"/></mxCell><mxCell id="b105" value="Audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="192" width="236" height="22" as="geometry"/></mxCell><mxCell id="b106" value="UI, text, menus, HUD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9ec;strokeColor=#c2558c;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="218" width="236" height="22" as="geometry"/></mxCell><mxCell id="b107" value="Cinematics, fades, transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="244" width="236" height="22" as="geometry"/></mxCell><mxCell id="b108" value="Level data / loading" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="270" width="236" height="22" as="geometry"/></mxCell><mxCell id="b109" value="Saves, settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c98"><mxGeometry x="12" y="296" width="236" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Start-up and level loading"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Start-up (once) and loading a level (every scene change)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Game_Main runs once; Progress::GotoScene runs at start-up and again from Level_ExitUpdate (frame step A9) for every level change, restart or menu exit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Game_Main  (app/app_main.cpp)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="420" height="830" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Options&lt;/b&gt;&lt;br&gt;defaults -&gt; saved settings -&gt; command-line flags from the launcher (--renderer, --width, --controller, --level, --game-dir ...)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;platform/options.c&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="40" width="380" height="85" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Data paths&lt;/b&gt;&lt;br&gt;Levels/, Musics/, Voices/, References/, Bonus/ under the game folder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="140" width="380" height="60" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b7" value="&lt;b&gt;Text catalogue&lt;/b&gt;&lt;br&gt;References/GREET_txt.BSM: start-up error texts; language from the OS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9ec;strokeColor=#c2558c;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="215" width="380" height="60" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b9" value="&lt;b&gt;Platform_Init&lt;/b&gt;&lt;br&gt;SDL video + gamepad; wait up to 2 s for the chosen controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="290" width="380" height="60" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b7" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b11" value="&lt;b&gt;new D3DApp, new SoundDevice&lt;/b&gt;&lt;br&gt;the device wrapper the game draws through; the sound system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="365" width="380" height="60" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b9" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b13" value="&lt;b&gt;Render_CreateBackend&lt;/b&gt;&lt;br&gt;SDL3 GPU backend (Vulkan / D3D12 / Metal)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;render/render_select.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="440" width="380" height="65" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b11" target="b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b15" value="&lt;b&gt;Platform_CreateWindow + PrepareDisplay&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="20" y="520" width="380" height="45" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b13" target="b15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b17" value="&lt;b&gt;Render_CreateDevice, SoundDevice::Init&lt;/b&gt;&lt;br&gt;22050 Hz, 16-bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalA