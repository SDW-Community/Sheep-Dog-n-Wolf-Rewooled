<mxfile host="drawio" agent="sdw-diagrams" version="24.0.0"><diagram id="p0" name="1. Systems map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Systems map - what exists and how the parts reach each other" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1600" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Boxes inside a container are the files / classes of that system. Arrows between containers are the dependencies, labelled with how they are made (mostly direct access to globals). Counts = source files that use it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="2000" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Launcher  (separate program: SheepLauncher)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="560" height="190" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Dear ImGui window&lt;/b&gt;&lt;br&gt;video / controller / install (PSX disc extraction, XA audio, SND conversion), update check, credits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="15" y="35" width="530" height="70" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Starts SheepD3D with flags&lt;/b&gt;&lt;br&gt;--renderer --width --height --fullscreen --controller --level --game-dir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c3"><mxGeometry x="15" y="115" width="530" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Input  (app/, engine/input*.cpp)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="560" height="480" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;Keyboard / Joystick / Mouse : InputDevice&lt;/b&gt;&lt;br&gt;button arrays + axes, read from SDL each frame&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;app/keyboard.cpp, app/joystick.cpp, engine/mouse.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c6"><mxGeometry x="15" y="35" width="530" height="70" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;InputMgr  g_inputMgr  (12 files)&lt;/b&gt;&lt;br&gt;device in use (keyboard + controller together), binding tables keyTable / padTable, fixed controller mapping, PS1 button word padBits, sticks, tap-to-run, Legacy Controls, save / load bindings&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/input_mgr.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c6"><mxGeometry x="15" y="115" width="530" height="95" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Pad  g_pad / g_pad2  (26 files)&lt;/b&gt;&lt;br&gt;a fake PlayStation pad: Latch (cur / prev), auto-repeat, dead zones, action remap g_inputMap / g_padMasks, menu tests Pad_MenuHeld / Pressed&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/input.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c6"><mxGeometry x="15" y="220" width="530" height="80" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Readers&lt;/b&gt;&lt;br&gt;ScnControllable::ReadPad (Wolf, Robot) -&gt; stick heading relative to g_camYaw; Camera; menus; ~30 objects test g_pad directly (cannon, telescope, catapult ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c6"><mxGeometry x="15" y="310" width="530" height="75" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Cheats&lt;/b&gt;&lt;br&gt;Cheat_Poll: key sequences&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/cheat.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c6"><mxGeometry x="15" y="395" width="530" height="50" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Time  (engine/time.cpp, timer.cpp)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="560" height="175" as="geometry"/></mxCell><mxCell id="b16" value="&lt;b&gt;Time_Update -&gt; g_dt (65 files), g_dtRaw, g_animDt, g_dtMs, g_timeScale&lt;/b&gt;&lt;br&gt;1/4096 s; capped at 41.5 ms; 0 while paused. Timer objects (g_pTimer, per-object timers). Frame limiter in D3DApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c15"><mxGeometry x="15" y="35" width="530" height="75" as="geometry"/></mxCell><mxCell id="b17" value="&lt;b&gt;GameState&lt;/b&gt;&lt;br&gt;stored at &amp;amp;g_animDt (a struct laid over the time globals)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/game_state.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c15"><mxGeometry x="15" y="115" width="530" height="50" as="geometry"/></mxCell><mxCell id="c18" value="Saves and settings" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#e6e6e6;strokeColor=#4d4d4d;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="560" height="310" as="geometry"/></mxCell><mxCell id="b19" value="&lt;b&gt;registry.cpp  Reg_*&lt;/b&gt;&lt;br&gt;the original registry API, kept; keys Progress, Config (key bindings), Setup, CfgGame (camera sliders, Legacy Controls)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c18"><mxGeometry x="15" y="35" width="530" height="75" as="geometry"/></mxCell><mxCell id="b20" value="&lt;b&gt;save_store.c&lt;/b&gt;&lt;br&gt;one file per key in the user's data folder (SDWK format)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;platform/save_store.c&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c18"><mxGeometry x="15" y="120" width="530" height="55" as="geometry"/></mxCell><mxCell id="b21" value="&lt;b&gt;Progress  g_pProgress  (28 files)&lt;/b&gt;&lt;br&gt;current level, scene paths, sheep counts, controls preset, GotoScene / RestartScene / Level_FinishScene&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/progress*.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c18"><mxGeometry x="15" y="185" width="530" height="70" as="geometry"/></mxCell><mxCell id="b22" value="&lt;b&gt;Memory card objects&lt;/b&gt;&lt;br&gt;MCardManager, MCard_Init&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;objects/mcard.cpp, engine/card.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="c18"><mxGeometry x="15" y="260" width="530" height="40" as="geometry"/></mxCell><mxCell id="c23" value="Scenaric object system  (engine/scenaric*.cpp, scn_register.cpp)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="600" height="520" as="geometry"/></mxCell><mxCell id="b24" value="&lt;b&gt;Class registry&lt;/b&gt;&lt;br&gt;Scenaric_RegisterAllClasses: class id (197 classes) -&gt; constructor; Install_ScenaricResource builds an object from its WAR record&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/scn_register.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c23"><mxGeometry x="15" y="35" width="570" height="70" as="geometry"/></mxCell><mxCell id="b25" value="&lt;b&gt;Object arrays&lt;/b&gt;&lt;br&gt;g_scnObjects (from the level file), g_scnActive (+ spawned), g_worldObjs (static meshes), g_cineObjects; AddToWorld / RemoveFromWorld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c23"><mxGeometry x="15" y="115" width="570" height="65" as="geometry"/></mxCell><mxCell id="b26" value="&lt;b&gt;ScnObject virtuals&lt;/b&gt;&lt;br&gt;PostLoadInit, Update, Render, HandleMessage, Reset, CustomCollide, SetPosition -&gt; page 2 for the hierarchy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c23"><mxGeometry x="15" y="190" width="570" height="60" as="geometry"/></mxCell><mxCell id="b27" value="&lt;b&gt;Messages&lt;/b&gt;&lt;br&gt;HandleMessage(sender, msgId, arg): numeric ids, untyped arg - &lt;b&gt;1208 call sites&lt;/b&gt;; the main way objects talk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c23"><mxGeometry x="15" y="260" width="570" height="60" as="geometry"/></mxCell><mxCell id="b28" value="&lt;b&gt;Collision&lt;/b&gt;&lt;br&gt;Collide_*, coll_clip, collision grid + triangles from the WAR, boxes, ObjGrid clusters, navigation (50 files)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/collide.cpp, coll_clip.cpp, obj_grid.cpp, navigation.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c23"><mxGeometry x="15" y="330" width="570" height="75" as="geometry"/></mxCell><mxCell id="b29" value="&lt;b&gt;Attach links, trajectories, Instance / Animator&lt;/b&gt;&lt;br&gt;objects riding on others; path followers; animation state of a mesh instance&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;objects/instance.cpp, objects/animation.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c23"><mxGeometry x="15" y="415" width="570" height="90" as="geometry"/></mxCell><mxCell id="c30" value="Gameplay  (game/, objects/ - 194 files)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1280" y="90" width="560" height="520" as="geometry"/></mxCell><mxCell id="b31" value="&lt;b&gt;Wolf  g_pWolf  (111 files!)&lt;/b&gt;&lt;br&gt;Ralph: input -&gt; state machine (~200 states) -&gt; movement profiles -&gt; collision; held item, costumes, item wheel, action prompts (HUD), sounds, death / respawn&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;game/wolf*.cpp, game/scn_controllable.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c30"><mxGeometry x="15" y="35" width="530" height="95" as="geometry"/></mxCell><mxCell id="b32" value="&lt;b&gt;Sam, sheep, enemies, bosses&lt;/b&gt;&lt;br&gt;Sam / Sam_Pirate, Sheep, Daffy*, Elmer, Gossamer, Marvin, Dragon ... each reads g_pWolf and messages it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c30"><mxGeometry x="15" y="140" width="530" height="65" as="geometry"/></mxCell><mxCell id="b33" value="&lt;b&gt;Props and puzzles&lt;/b&gt;&lt;br&gt;doors, cannons, catapult, seesaw, crane, train, raft, mines, rods ... (ScnBody / ScnMobile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c30"><mxGeometry x="15" y="215" width="530" height="60" as="geometry"/></mxCell><mxCell id="b34" value="&lt;b&gt;Managers (ScnLogic)&lt;/b&gt;&lt;br&gt;ObjectManager, CheckpointManager, AmbientSoundManager, FogManager, VisibilityManager, BonusManager (HUD counters), CreditsManager ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c30"><mxGeometry x="15" y="285" width="530" height="65" as="geometry"/></mxCell><mxCell id="b35" value="&lt;b&gt;Inventory + item wheel&lt;/b&gt;&lt;br&gt;per-class lists, selection, ItemFly, InvWheel_Render&lt