"c78"><mxGeometry x="15" y="35" width="750" height="75" as="geometry"/></mxCell><mxCell id="b80" value="&lt;b&gt;StreamPlayer  g_pStreamPlayer (11)&lt;/b&gt;&lt;br&gt;music per level + voice lines; loader thread; double-buffered StreamSound; ducks music for voices&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/stream_player.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c78"><mxGeometry x="15" y="120" width="370" height="95" as="geometry"/></mxCell><mxCell id="b81" value="&lt;b&gt;Sound / StaticSound / StreamSound, WaveFile&lt;/b&gt;&lt;br&gt;DirectSound buffers; RIFF reading via mmio&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/sound.cpp, static_sound.cpp, stream_sound.cpp, wave_file.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c78"><mxGeometry x="395" y="120" width="370" height="95" as="geometry"/></mxCell><mxCell id="b82" value="&lt;b&gt;SoundDevice  g_pSoundSystem (10)&lt;/b&gt;&lt;br&gt;the DirectSound device; silent loop on voice 0 keeps it awake&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;engine/sound_device.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c78"><mxGeometry x="15" y="225" width="750" height="60" as="geometry"/></mxCell><mxCell id="b83" value="&lt;b&gt;DirectSound interfaces over SDL&lt;/b&gt;&lt;br&gt;IDirectSound / IDirectSoundBuffer emulated&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;platform/dsound_sdl.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c78"><mxGeometry x="15" y="295" width="750" height="55" as="geometry"/></mxCell><mxCell id="b84" value="&lt;b&gt;SDL3 audio mixer&lt;/b&gt;&lt;br&gt;voices at DirectSound's volume / pan units, notifications&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;platform/platform_audio_sdl.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c78"><mxGeometry x="15" y="360" width="750" height="60" as="geometry"/></mxCell><mxCell id="e85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b79" target="b82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b80" target="b81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b81" target="b82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b82" target="b83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b83" target="b84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c90" value="The real wiring: global singletons (files that use each)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#ffffff;strokeColor=#b85450;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="640" y="1375" width="1200" height="205" as="geometry"/></mxCell><mxCell id="b91" value="&lt;b&gt;Reached directly from anywhere&lt;/b&gt;&lt;br&gt;g_pWolf 111 · g_dt 65 · g_camera 55 · g_gameFlags 33 (update / render / pause / loaded bits) · g_cinePlayer 29 · g_pProgress 28 · g_screen 28 · g_pPolyBin 26 · g_pad 26 · g_pViewFrustum 24 · g_inputMgr 12 · g_pStreamPlayer 11 · g_pSoundSystem 10 · g_renderDevice 9 - about 900 distinct g_ names across the game code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;dashed=1;" vertex="1" parent="c90"><mxGeometry x="15" y="35" width="1170" height="80" as="geometry"/></mxCell><mxCell id="b92" value="&lt;b&gt;What that means for a refactor&lt;/b&gt;&lt;br&gt;Systems have no interfaces between them: an object includes sdw_classes.h (every class) and touches the globals it needs. Good first seams: (1) wrap each singleton behind a small API in its own header, (2) make HandleMessage ids an enum with typed payloads, (3) split update from render in Game_Frame, (4) move input before update." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;dashed=1;" vertex="1" parent="c90"><mxGeometry x="15" y="120" width="1170" height="75" as="geometry"/></mxCell><mxCell id="c93" value="Platform layer - SDL3  (platform/) - under Input, Rendering, Audio and Saves; the launcher's flags arrive in Options" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="1720" width="2620" height="220" as="geometry"/></mxCell><mxCell id="b94" value="&lt;b&gt;Window + events&lt;/b&gt;&lt;br&gt;Platform_Init, CreateWindow, PollEvents, focus, hot-plug&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;platform_sdl.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c93"><mxGeometry x="15" y="35" width="416" height="170" as="geometry"/></mxCell><mxCell id="b95" value="&lt;b&gt;Input reading&lt;/b&gt;&lt;br&gt;Platform_ReadKeyboard / Joystick / Mouse, fixed pad mapping, mouse capture, wheel, clicks&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;platform_sdl.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c93"><mxGeometry x="446" y="35" width="416" height="170" as="geometry"/></mxCell><mxCell id="b96" value="&lt;b&gt;Audio&lt;/b&gt;&lt;br&gt;DirectSound shim + SDL mixer, WAV loading&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;dsound_sdl.cpp, platform_audio_sdl.cpp, wav_sdl.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c93"><mxGeometry x="877" y="35" width="416" height="170" as="geometry"/></mxCell><mxCell id="b97" value="&lt;b&gt;Files&lt;/b&gt;&lt;br&gt;case-insensitive lookup, save_store, PNG loading (retexture, icons)&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;crt_posix_compat.cpp, save_store.c&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c93"><mxGeometry x="1308" y="35" width="416" height="170" as="geometry"/></mxCell><mxCell id="b98" value="&lt;b&gt;Options&lt;/b&gt;&lt;br&gt;saved settings + command-line flags from the launcher&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;options.c&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c93"><mxGeometry x="1739" y="35" width="416" height="170" as="geometry"/></mxCell><mxCell id="b99" value="&lt;b&gt;Windows API names&lt;/b&gt;&lt;br&gt;MessageBox, registry, mmio, timers ... on macOS / Linux&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;win32_sdl_compat.cpp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;" vertex="1" parent="c93"><mxGeometry x="2170" y="35" width="416" height="170" as="geometry"/></mxCell><mxCell id="b100" value="&lt;b&gt;How the systems connect&lt;/b&gt; (numbers on the arrows)&lt;table style=&quot;font-size:10.5px;margin-top:3px&quot; cellpadding=&quot;1&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Input -&gt; Gameplay&lt;/b&gt;&lt;/td&gt;&lt;td&gt;g_pad read by ScnControllable::ReadPad and ~30 objects (26 files)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Input -&gt; Camera&lt;/b&gt;&lt;/td&gt;&lt;td&gt;right stick, L2 / R2, mouse (orbit)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Gameplay &lt;-&gt; Scenaric&lt;/b&gt;&lt;/td&gt;&lt;td&gt;every object is an ScnObject; they talk by HandleMessage (1208 call sites)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Gameplay &lt;-&gt; Camera&lt;/b&gt;&lt;/td&gt;&lt;td&gt;camera reads g_pWolf + g_camReq* requests; objects read g_camera / g_camYaw (55)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cinematics -&gt; Gameplay&lt;/b&gt;&lt;/td&gt;&lt;td&gt;moves objects by messages; waits for the Wolf's acknowledgement&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cinematics -&gt; Camera&lt;/b&gt;&lt;/td&gt;&lt;td&gt;scripted shots&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Scenaric -&gt; Rendering&lt;/b&gt;&lt;/td&gt;&lt;td&gt;obj-&gt;Render -&gt; Instance -&gt; Mesh -&gt; PolyBatcher&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;UI -&gt; Rendering&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Text_DrawString / Draw2D polygons into the PolyBatcher&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Gameplay -&gt; Audio&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Sound_Play from 73 files; StreamPlayer for voice lines&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;UI -&gt; Audio&lt;/b&gt;&lt;/td&gt;&lt;td&gt;menu sounds; dialogue voice lines&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Gameplay -&gt; UI&lt;/b&gt;&lt;/td&gt;&lt;td&gt;prompts, HUD counters, dialogue boxes, item wheel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Level data -&gt; Rendering&lt;/b&gt;&lt;/td&gt;&lt;td&gt;texture pages, meshes, fonts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;13&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Level data -&gt; Scenaric&lt;/b&gt;&lt;/td&gt;&lt;td&gt;object records -&gt; class factory; collision grid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;14&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Level data -&gt; Audio&lt;/b&gt;&lt;/td&gt;&lt;td&gt;SND bank, music / voice list&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;15&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Saves &lt;-&gt; Gameplay&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Progress (28 files): level, sheep counts, scene changes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Saves &lt;-&gt; Input&lt;/b&gt;&lt;/td&gt;&lt;td&gt;key bindings (Config), Legacy Controls (CfgGame)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;Not drawn: Time (g_dt) and the platform layer are used by everything." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1375" width="560" height="315" as="geometry"/></mxCell><mxCell id="e101" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c30"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="616" y="670"/><mxPoint x="616" y="626"/><mxPoint x="1504" y="626"/></Array></mxGeometry></mxCell><mxCell id="e102" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.96;exitDx=0;exitDy=0;entryX=0;entryY=0.39;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c37"><mxGeometry relative="1" as