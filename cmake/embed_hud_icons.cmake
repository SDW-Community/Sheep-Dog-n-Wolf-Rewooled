# Embeds every PNG under res/hud/icons/ into a header (src/engine/hud/hud_icons.cpp, g_sdwHudIcons), with its path
# ("hud/icons/xbox/a_1.png"). Run at every build by the sdw_hud_icons target (CMakeLists.txt), as
#   cmake -DSRC=<res dir> -DOUT=<header> -P embed_hud_icons.cmake
# It reads the PNGs' contents rather than trusting their dates (an image editor can save a PNG keeping its old date),
# and rewrites the header only when it changed, so a build with no new icon recompiles nothing.
file(GLOB_RECURSE files "${SRC}/hud/icons/*.png")
list(SORT files)
set(code "/* generated by cmake/embed_hud_icons.cmake from res/hud/icons/ */\n")
set(table "")
set(index 0)
foreach(icon IN LISTS files)
    file(RELATIVE_PATH icon_path "${SRC}" "${icon}")
    file(READ "${icon}" icon_hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," icon_bytes "${icon_hex}")
    string(APPEND code "static const unsigned char g_sdwHudIcon${index}[] = {${icon_bytes}};\n")
    string(APPEND table "    {\"${icon_path}\", g_sdwHudIcon${index}, sizeof(g_sdwHudIcon${index})},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND code
        "static const struct {\n    const char *path;\n    const unsigned char *png;\n    unsigned size;\n} g_sdwHudIcons[] = {\n"
        "${table}    {0, 0, 0}\n};\n")
file(WRITE "${OUT}.tmp" "${code}")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
